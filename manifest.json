{
  "manifest_version": 3,
  "name": "Diggin: Vinyl Price Search",
  "version": "1.0.0",
  "description": "Instant Discogs pricing for vinyl collectors.",
  "permissions": ["activeTab", "scripting", "contextMenus"],
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
